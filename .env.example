# VIPORDER.COM.VN backend — environment template.
#
# Every value is EMPTY on purpose. An empty environment variable means "unset",
# so copying this file to `.env` and changing nothing gives you the documented
# defaults (mock provider, SQLite under var/, CORS off, admin route disabled).
#
# NEVER commit a filled-in `.env`. This repository is public.
# See backend/README.md for the full explanation of each key.

# --- Service ----------------------------------------------------------------

# development | staging | production
APP_ENV=

# Reported by GET /api/v1/health.
SERVICE_NAME=
APP_VERSION=

# --- Persistence ------------------------------------------------------------

# Default: sqlite:///./var/viporder.db (git-ignored, created on demand).
# Production: postgresql+psycopg://user:password@host:5432/viporder
DATABASE_URL=

# yes | no. Default yes. Set to "no" in deployments where Alembic owns the
# schema, so `alembic upgrade head` is the only thing that creates tables.
AUTO_CREATE_SCHEMA=

# --- Registration provider --------------------------------------------------

# mock | http. Default mock. The real upstream contract has NOT been supplied;
# leaving this empty keeps every call in-process.
KHAIBAO9610_MODE=

# Candidate, UNVERIFIED upstream base URL. Only used with the mode and the
# real-call switch below.
KHAIBAO9610_BASE_URL=

# Seconds. Default 10, allowed 1..30.
KHAIBAO9610_TIMEOUT_SECONDS=

# yes | no. Default no. Reaching a real customer system requires BOTH
# KHAIBAO9610_MODE=http AND this set to yes. Anything else refuses to start the
# live adapter.
KHAIBAO9610_ENABLE_REAL_CALLS=
# Registration WRITES are a SEPARATE switch. Reads and writes are gated
# independently so that enabling live tracking cannot create a customer.
KHAIBAO9610_ENABLE_REAL_REGISTRATION=

# A real browser User-Agent. The upstream sits behind Cloudflare, which rejects
# non-browser clients with Error 1010. Empty means the built-in default.
KHAIBAO9610_USER_AGENT=

# --- Upstream paths ---------------------------------------------------------
# Path templates, each starting with "/". The two tracking templates must
# contain exactly one "{keyword}" placeholder, which is replaced by a
# URL-encoded path segment. Empty means the built-in default shown here.
#
# Measured against the live service: /warehouse-imports/{keyword} answers with a
# BARE json object, while /package-sealings/{keyword} answers with
# {"data": {...}}. The two envelopes differ and are not interchangeable.
KHAIBAO9610_REGISTER_PATH=
KHAIBAO9610_WAREHOUSE_IMPORT_PATH=
KHAIBAO9610_PACKAGE_SEALING_PATH=

# Cap on a tracking response body, in bytes. Default 2097152 (2 MiB). The
# upstream is a third party, so one oversized reply must not be able to exhaust
# a worker's memory.
KHAIBAO9610_MAX_RESPONSE_BYTES=

# success | duplicate | invalid | unavailable | timeout | error. Default success.
# Only consulted in mock mode.
MOCK_PROVIDER_BEHAVIOUR=

# --- Admin retry ------------------------------------------------------------

# Empty (the default) means the admin retry route does not exist: it answers
# 404 like any unknown path. Set it to a long random value to enable the route.
ADMIN_API_TOKEN=

# --- API documentation ------------------------------------------------------

# yes | no. Empty (the default) means "decide from APP_ENV": /docs and
# /openapi.json are served everywhere except production, where they are off.
# They enumerate every route, parameter and error code, which the public site
# does not need. Set to yes to force them on in production anyway.
ENABLE_API_DOCS=

# --- Security ---------------------------------------------------------------

# Default 65536 (64 KiB). Larger bodies get 413.
MAX_REQUEST_BYTES=

# yes | no. Default yes.
RATE_LIMIT_ENABLED=

# Default 10 attempts per RATE_LIMIT_WINDOW_SECONDS per client IP.
RATE_LIMIT_ATTEMPTS=
RATE_LIMIT_WINDOW_SECONDS=

# One attempt in flight per phone. A claim older than this many seconds is
# treated as abandoned and reclaimed, so a process killed mid-attempt cannot
# block a phone forever. Keep it comfortably above KHAIBAO9610_TIMEOUT_SECONDS.
PHONE_CLAIM_TTL_SECONDS=

# yes | no. Default no. Only set yes when this service genuinely sits behind a
# trusted proxy; otherwise clients can forge their IP and escape the limiter.
TRUST_PROXY_HEADERS=

# Comma-separated origins. Empty (the default) disables CORS entirely and the
# service is same-origin only. Never combine "*" with credentials.
CORS_ALLOW_ORIGINS=
